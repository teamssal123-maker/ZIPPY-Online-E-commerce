datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  super_admin
  admin
  manager
  inventory_manager
  sales_manager
  content_manager
  editor
  support_staff
  customer
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum UserStatus {
  active
  inactive
  blocked
}

enum ProductStatus {
  draft
  published
  archived
  active
  inactive
}

enum OrderStatus {
  pending
  confirmed
  processing
  packed
  shipped
  out_for_delivery
  delivered
  cancelled
  returned
  refunded
}

enum PaymentMethod {
  cash_on_delivery
  bank_transfer
  online_payment
  mobile_payment
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum DiscountType {
  percentage_discount
  fixed_discount
  buy_one_get_one
  category_discount
  brand_discount
  product_discount
  minimum_order_discount
  free_shipping
}

enum InventoryTxType {
  purchase
  sale
  return
  damage
  adjustment
  transfer
  opening_stock
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  phone         String
  passwordHash  String     @map("password_hash")
  role          UserRole   @default(CUSTOMER)
  roleId        String?    @map("role_id")
  adminRole     RoleType?  @map("admin_role")
  fullName      String     @map("full_name")
  firstName     String?    @map("first_name")
  lastName      String?    @map("last_name")
  profileImage  String?    @map("profile_image")
  dateOfBirth   String?    @map("date_of_birth")
  gender        String?
  status        UserStatus @default(active)
  lastLogin     DateTime?  @map("last_login")
  emailVerified Boolean    @default(false) @map("email_verified")
  phoneVerified Boolean    @default(false) @map("phone_verified")
  deletedAt     DateTime?  @map("deleted_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  roleRel   Role?             @relation(fields: [roleId], references: [id])
  addresses CustomerAddress[]
  orders    Order[]
  reviews   Review[]
  wishlist  WishlistItem[]
  auditLogs AuditLog[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model CustomerAddress {
  id          String    @id @default(uuid())
  customerId  String    @map("customer_id")
  name        String?
  phone       String
  address     String
  city        String?
  district    String
  division    String
  postalCode  String?   @map("postal_code")
  country     String    @default("Bangladesh")
  addressType String    @default("shipping") @map("address_type")
  isDefault   Boolean   @default(false) @map("is_default")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model Category {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  parentId        String?   @map("parent_id")
  description     String?
  image           String?
  icon            String?
  sortOrder       Int       @default(0) @map("sort_order")
  status          String    @default("active")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id])
  subcategories Category[] @relation("SubCategories")
  products      Product[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  logo            String?
  banner          String?
  description     String?
  website         String?
  status          String    @default("active")
  sortOrder       Int       @default(0) @map("sort_order")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@index([slug])
  @@map("brands")
}

model Product {
  id                String        @id @default(uuid())
  name              String
  slug              String        @unique
  sku               String        @unique
  barcode           String?
  shortDescription  String?       @map("short_description")
  description       String
  brandId           String?       @map("brand_id")
  categoryId        String        @map("category_id")
  subcategoryId     String?       @map("subcategory_id")
  price             Float
  salePrice         Float?        @map("sale_price")
  costPrice         Float?        @map("cost_price")
  tax               Float?        @default(0)
  stockQuantity     Int           @default(0) @map("stock_quantity")
  lowStockThreshold Int           @default(5) @map("low_stock_threshold")
  weight            Float?
  dimensions        Json?
  status            ProductStatus @default(active)
  featured          Boolean       @default(false)
  newArrival        Boolean       @default(false) @map("new_arrival")
  bestSeller        Boolean       @default(false) @map("best_seller")
  trending          Boolean       @default(false)
  isActive          Boolean       @default(true) @map("is_active")
  fabric            String?
  fit               String?
  gender            String?       @default("Men")
  images            String[]      @default([])
  colors            Json?
  sizes             String[]      @default([])
  stock             Json?
  rating            Float         @default(5.0)
  reviewCount       Int           @default(0) @map("review_count")
  careInstructions  String[]      @default([]) @map("care_instructions")
  tags              String[]      @default([])
  customAttributes  Json?         @map("custom_attributes")
  metaTitle         String?       @map("meta_title")
  metaDescription   String?       @map("meta_description")
  metaKeywords      String?       @map("meta_keywords")
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  category     Category               @relation(fields: [categoryId], references: [id])
  brand        Brand?                 @relation(fields: [brandId], references: [id])
  variants     ProductVariant[]
  imagesList   ProductImage[]
  inventory    Inventory[]
  orderItems   OrderItem[]
  reviews      Review[]
  inquiries    ProductInquiry[]
  wishlist     WishlistItem[]
  transactions InventoryTransaction[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([featured])
  @@index([bestSeller])
  @@map("products")
}

model ProductVariant {
  id            String    @id @default(uuid())
  productId     String    @map("product_id")
  variantName   String    @map("variant_name")
  sku           String    @unique
  price         Float?
  salePrice     Float?    @map("sale_price")
  stockQuantity Int       @default(0) @map("stock_quantity")
  image         String?
  status        String    @default("active")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory[]
  orderItems   OrderItem[]
  transactions InventoryTransaction[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  altText   String?  @map("alt_text")
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Warehouse {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  address   String
  phone     String
  manager   String
  status    String    @default("active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  inventory    Inventory[]
  transactions InventoryTransaction[]

  @@map("warehouses")
}

model Inventory {
  id                String   @id @default(uuid())
  productId         String   @map("product_id")
  variantId         String?  @map("variant_id")
  warehouseId       String   @map("warehouse_id")
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  availableQuantity Int      @default(0) @map("available_quantity")
  minimumStock      Int      @default(5) @map("minimum_stock")
  maximumStock      Int      @default(1000) @map("maximum_stock")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventory")
}

model InventoryTransaction {
  id          String           @id @default(uuid())
  productId   String           @map("product_id")
  variantId   String?          @map("variant_id")
  warehouseId String           @map("warehouse_id")
  type        InventoryTxType
  quantity    Int
  reference   String?
  note        String?
  createdBy   String?          @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@map("inventory_transactions")
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique @map("order_number")
  customerId      String?       @map("customer_id")
  subtotal        Float
  discount        Float         @default(0)
  couponDiscount  Float         @default(0) @map("coupon_discount")
  shippingCost    Float         @default(0) @map("shipping_cost")
  tax             Float         @default(0)
  total           Float         @map("grand_total")
  paymentMethod   PaymentMethod @map("payment_method")
  paymentStatus   PaymentStatus @default(pending) @map("payment_status")
  paymentId       String?       @map("payment_id")
  orderStatus     OrderStatus   @default(pending) @map("order_status")
  customer        Json
  shippingAddress String        @map("shipping_address")
  billingAddress  String        @map("billing_address")
  customerNote    String?       @map("customer_note")
  adminNote       String?       @map("admin_note")
  trackingHistory Json?         @map("tracking_history")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user     User?       @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  payments Payment[]
  reviews  Review[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  variantId   String?  @map("variant_id")
  productName String   @map("product_name")
  sku         String
  size        String?
  color       Json?
  quantity    Int
  price       Float    @map("unit_price")
  discount    Float    @default(0)
  total       Float
  productData Json     @map("product_data")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  transactionId   String        @map("transaction_id")
  paymentMethod   PaymentMethod @map("payment_method")
  amount          Float
  currency        String        @default("BDT")
  status          PaymentStatus @default(pending)
  gatewayResponse Json?         @map("gateway_response")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

model ShippingMethod {
  id                    String    @id @default(uuid())
  name                  String
  zone                  String
  deliveryCharge        Float     @map("delivery_charge")
  freeShippingThreshold Float?    @map("free_shipping_threshold")
  estimatedDeliveryDays String    @map("estimated_delivery_days")
  status                String    @default("active")
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("shipping_methods")
}

model Review {
  id         String       @id @default(uuid())
  productId  String       @map("product_id")
  customerId String?      @map("customer_id")
  orderId    String?      @map("order_id")
  authorName String       @map("author_name")
  rating     Float
  title      String?
  comment    String
  images     String[]     @default([])
  status     ReviewStatus @default(approved)
  adminReply String?      @map("admin_reply")
  createdAt  DateTime     @default(now()) @map("created_at")

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer User?   @relation(fields: [customerId], references: [id])
  order    Order?  @relation(fields: [orderId], references: [id])

  @@index([productId])
  @@index([status])
  @@map("reviews")
}

model ProductInquiry {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  name       String
  email      String
  phone      String
  message    String
  status     String   @default("pending")
  adminReply String?  @map("admin_reply")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@map("product_inquiries")
}

model WishlistItem {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  productId  String   @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@map("wishlist")
}

model Banner {
  id           String    @id @default(uuid())
  title        String
  subtitle     String?
  imageDesktop String    @map("image_desktop")
  imageMobile  String?   @map("image_mobile")
  buttonText   String?   @map("button_text")
  buttonUrl    String?   @map("button_url")
  position     String    @default("hero")
  sortOrder    Int       @default(0) @map("sort_order")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("banners")
}

model HomepageSection {
  id        String   @id @default(uuid())
  type      String
  title     String
  subtitle  String?
  content   Json?
  sortOrder Int      @default(0) @map("sort_order")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("homepage_sections")
}

model Offer {
  id                 String       @id @default(uuid())
  name               String
  code               String?      @unique
  discountType       DiscountType @map("discount_type")
  discountValue      Float        @map("discount_value")
  minimumOrderAmount Float?       @map("minimum_order_amount")
  maximumDiscount    Float?       @map("maximum_discount")
  usageLimit         Int?         @map("usage_limit")
  perCustomerLimit   Int?         @map("per_customer_limit")
  startDate          DateTime?    @map("start_date")
  endDate            DateTime?    @map("end_date")
  status             String       @default("active")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("offers")
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  description     String
  discountType    String    @default("percent") @map("discount_type")
  discountValue   Float     @map("discount_value")
  discountPercent Float?    @map("discount_percent")
  discountAmount  Float?    @map("discount_amount")
  minOrder        Float     @default(0) @map("min_order")
  minSpend        Float?    @map("min_spend")
  maximumDiscount Float?    @map("maximum_discount")
  usageLimit      Int?      @map("usage_limit")
  usedCount       Int       @default(0) @map("used_count")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  expiresAt       DateTime? @map("expires_at")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("coupons")
}

model BlogPost {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String
  featuredImage   String?   @map("featured_image")
  authorId        String?   @map("author_id")
  categoryId      String?   @map("category_id")
  tags            String[]  @default([])
  status          String    @default("draft")
  publishedAt     DateTime? @map("published_at")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model Page {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  content         String
  featuredImage   String?  @map("featured_image")
  status          String   @default("published")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model Media {
  id        String   @id @default(uuid())
  name      String
  url       String
  mimeType  String   @map("mime_type")
  size      Int
  folder    String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([folder])
  @@map("media")
}

model WebsiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("website_settings")
}

model Notification {
  id        String   @id @default(uuid())
  channel   String
  event     String
  payload   Json
  sent      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([channel])
  @@index([event])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  module    String
  recordId  String?  @map("record_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([action])
  @@map("audit_logs")
}

model SeoRedirect {
  id         String   @id @default(uuid())
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  statusCode Int      @default(301) @map("status_code")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("seo_redirects")
}
